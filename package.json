{
  "name": "github-data-pipeline",
  "version": "1.0.0",
  "description": "Headless TypeScript pipeline that discovers GitHub developers, scores their open-source contributions, and stores ranked profiles in PostgreSQL.",
  "main": "dist/cli.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "bulk-discover": "tsx src/scripts/bulk-discover.ts",
    "discover-repos": "tsx src/scripts/discover-repos.ts",
    "team-marks": "tsx src/scripts/discover-repos.ts",
    "refresh-worker": "tsx src/scripts/refresh-worker.ts",
    "compute-repo-health": "tsx src/scripts/compute-repo-health.ts",
    "refresh-top-repos": "tsx src/scripts/refresh-top-repos.ts",
    "test:repo-score": "tsx src/scripts/test-contribution-score.ts",
    "enrich-linkedin": "tsx src/scripts/enrich-linkedin-apify.ts",
    "enrich-linkedin-sf": "tsx src/scripts/enrich-linkedin-sf.ts",
    "db:push": "drizzle-kit push",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "node --import tsx --test test/*.test.ts",
    "sql": "tsx src/scripts/run-sql.ts",
    "sql:populate-leaderboard": "tsx src/scripts/run-sql.ts populate-leaderboard",
    "sql:populate-analyses": "tsx src/scripts/run-sql.ts populate-analyses"
  },
  "keywords": [
    "github",
    "graphql",
    "postgres",
    "drizzle",
    "leaderboard",
    "developer-scoring"
  ],
  "author": "chemicoholic21",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^20.0.2",
    "axios": "^1.14.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  }
}
